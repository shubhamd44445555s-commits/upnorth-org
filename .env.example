# Groq — Ask UpNorth concierge (keep this server-side; never use a VITE_ prefix)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Supabase Connect panel — publishable key is safe for the browser; never use service_role here
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional server-only Supabase aliases. Never use service_role in VITE_ variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# dashboard.stripe.com — business listing payments
STRIPE_SECRET_KEY=
# Stripe Price ID for the Enhanced tier
STRIPE_PRICE_ENHANCED=
# Stripe Price ID for the Featured tier
STRIPE_PRICE_FEATURED=
# Mailchimp / ConvertKit / Resend — the Stay Up North newsletter
NEWSLETTER_API_KEY=
# Resend + Dynadot one-time domain provisioning (server/CLI only; never use VITE_)
RESEND_API_KEY=
RESEND_FROM_EMAIL=UpNorth.org <hello@your-verified-domain.example>
RESEND_DOMAIN=upnorth.org
DYNADOT_API_KEY=
DYNADOT_API_SECRET=
# Required only when intentionally applying live DNS changes
RESEND_SETUP_CONFIRM=
# Optional: use Dynadot's API sandbox URL while testing
DYNADOT_API_BASE_URL=https://api.dynadot.com
# Resend / SendGrid — new-listing notification emails
EMAIL_API_KEY=
# Optional newsletter provider adapter: brevo or mailchimp
NEWSLETTER_PROVIDER=
BREVO_LIST_ID=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
# console.cloud.google.com — real map embeds on town/listing pages
GOOGLE_MAPS_API_KEY=
